# API key for POST /transcript (Bearer or X-API-Key header). Required for the API service.
API_KEY=your-secret-key

# Redis URL for Celery broker. Required for both API and worker. Use an existing Redis instance.
REDIS_URL=redis://localhost:6379/0


# Whisper model: size name ("base", "small", ...) or path to local dir (e.g. whisper-model) to skip HF download
WHISPER_MODEL=base
# Optional cache dir when using a size name; not used when WHISPER_MODEL is a local path
# WHISPER_DOWNLOAD_ROOT=/data/whisper-models

# CTranslate2 compute type: int8 (less RAM), float16, float32, or auto
# WHISPER_COMPUTE_TYPE=int8

# Subtitle languages for yt-dlp --sub-langs (regex, comma-separated; "all" downloads any)
SUBTITLE_LANGS=en

# Whisper: skip non-speech segments (reduces hallucinations on silence/music)
# WHISPER_VAD_FILTER=true
# Whisper: batched inference (faster on CPU, higher peak memory)
# WHISPER_BATCHED=false
# Cache successful transcripts by video id (seconds; 0 disables)
# TRANSCRIPT_CACHE_TTL=604800

# Observability: optional env label for logs/traces
# ENV=prod

# OTLP traces (e.g. OpenObserve). If set, spans are exported to this URL.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://openobserve:5080/api/default/v1/traces
# Optional headers: comma-separated key=value (Basic auth + stream-name for OpenObserve).
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64(user:password)>,stream-name=default

# Docker Compose deployment shape (all optional; substituted in
# docker-compose.yaml):
#   AQUA_WHISPER_IMAGE      image to run; default aqua-whisper:latest, built
#                          locally by `docker compose up --build`
#   AQUA_WHISPER_PORT       host port for the API; default 8000
#   AQUA_WHISPER_NETWORK   external network to attach to; default
#                          aqua-whisper-backend (create once:
#                          `docker network create aqua-whisper-backend`)
#   AQUA_WHISPER_MODEL_DIR  host dir bind-mounted at /whisper-model;
#                          default ./whisper-model
#
# Production example (pull the CI-built image instead of building):
# AQUA_WHISPER_IMAGE=ghcr.io/wkf2000/aqua-whisper:latest
# AQUA_WHISPER_PORT=8509
# AQUA_WHISPER_NETWORK=1panel-network
# AQUA_WHISPER_MODEL_DIR=/home/michael/aqua-whisper/whisper-model/faster-whisper-base
